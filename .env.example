# Copy to .env, fill in from your Supabase project's Settings > API page.
# The anon/public key is safe to expose client-side (RLS enforces access control) —
# never put the service_role key here or anywhere client-side.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The AI pattern parser's key does NOT belong in this file. It is a Supabase secret, read only by
# the Edge Function:  supabase secrets set ANTHROPIC_API_KEY=sk-ant-…
# Anything EXPO_PUBLIC_-prefixed is compiled into the client bundle and is therefore public.
# See supabase/functions/README.md.
