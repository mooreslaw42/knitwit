.DS_Store
*.pem

# Claude Code: settings.json (plugins, permissions, the install-on-start hook) and launch.json
# (the dev servers the Browser pane can start) are shared; everything else is machine-specific.
# Gitignored files a new worktree still needs are listed in .worktreeinclude.
.claude/*
!.claude/settings.json
!.claude/launch.json

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# legacy demo fixture (not a build artifact, just kept out of git)
reference/example pattern.pdf
.vercel
.env*

# iCloud Drive writes "name 2.ext" conflict copies when a synced folder (Desktop, Documents) is
# edited faster than it syncs. One of those inside src/app becomes a route.
* 2.*
