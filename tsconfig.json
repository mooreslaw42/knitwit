{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Jest's globals (describe/it/expect) are ambient, so they need naming explicitly —
    // without this, `tsc --noEmit` fails on every test file even though the tests run fine.
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Edge Functions are Deno, not React Native: they use `Deno.*` globals and npm: import
  // specifiers, neither of which this compiler knows about. They're typechecked by
  // `supabase functions serve` / `deno check` instead.
  "exclude": [
    "supabase/functions"
  ]
}
