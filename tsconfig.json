{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Jest's globals (describe/it/expect) are ambient, so they need naming explicitly —
    // without this, `tsc --noEmit` fails on every test file even though the tests run fine.
    // "node" is here for one test that reads the SQL migrations off disk to check them against
    // the TypeScript catalogues; naming a type package here is what keeps the rest of Node's
    // globals out of app code, which has no business reaching for them.
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Edge Functions are Deno, not React Native: they use `Deno.*` globals and npm: import
  // specifiers, neither of which this compiler knows about. They're typechecked by
  // `supabase functions serve` / `deno check` instead.
  "exclude": [
    "supabase/functions",
    // The brand kit is design source, not app code. `source/handwritten/` holds the inputs the
    // generator injects data into, so they import modules that only exist once it has run.
    "brand-kit"
  ]
}
